{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification receipt protocol v1",
  "type": "object",
  "required": [
    "protocol_version",
    "task_id",
    "verified_at",
    "verified_hashes",
    "checks"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "functional",
              "error",
              "regression",
              "syntax",
              "security",
              "docs"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run",
              "not_applicable"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_file": {
            "type": "string"
          },
          "evidence_sha256": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "observed_result": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "environment",
                "observed_result",
                "exit_code",
                "evidence_file",
                "evidence_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}
